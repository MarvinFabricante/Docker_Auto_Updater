# Docker Auto-Updater Settings

# Container to update (Required)
CONTAINER_NAME=my-app

# Docker image to use (Optional: auto-detected if empty)
IMAGE_NAME=myregistry.com/my-app:latest

# How long to wait when stopping the container safely (seconds)
STOP_TIMEOUT=15

# How long to wait for the health check to pass (seconds)
HEALTH_TIMEOUT=60

# How often to check health (seconds)
HEALTH_INTERVAL=3

# Optional: web URL to check if working (e.g. http://localhost:8080/health)
HEALTH_URL=

# Optional: shell command to test health
HEALTH_CMD=

# Clean old unused images and cache after update (true/false)
AUTO_PRUNE=true

# Force update even if the image did not change (true/false)
FORCE_UPDATE=false

# Backup container suffix
BACKUP_SUFFIX=_rollback

# How often to check registry in watch mode (seconds)
WATCH_INTERVAL=60

# Port for the webhook server
WEBHOOK_PORT=9000

# Secret password for the webhook (optional)
WEBHOOK_SECRET=your-secret-token

# Optional: notification webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
