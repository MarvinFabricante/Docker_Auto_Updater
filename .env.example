# Docker Container Auto-Updater Configuration

# Target container name to manage (Required)
CONTAINER_NAME=my-app

# Image reference (Optional: if omitted, auto-detected from the running container)
IMAGE_NAME=myregistry.azurecr.io/myteam/my-app:latest

# Graceful stop timeout in seconds before SIGKILL (Default: 15)
STOP_TIMEOUT=15

# Maximum seconds to wait for container to report "healthy" (Default: 60)
HEALTH_TIMEOUT=60

# Interval in seconds between health checks (Default: 3)
HEALTH_INTERVAL=3

# Custom HTTP health check endpoint (Optional, used if image has no Dockerfile HEALTHCHECK)
# Example: http://localhost:8080/health
HEALTH_URL=

# Custom shell command to evaluate container health (Optional)
# Example: curl -sf http://localhost:8080/api/health
HEALTH_CMD=

# Automatically prune dangling images and builder caches on success (true/false)
AUTO_PRUNE=true

# Force re-deployment even if image digest is unchanged (true/false)
FORCE_UPDATE=false

# Suffix for temporary rollback container backup (Default: _rollback)
BACKUP_SUFFIX=_rollback

# Polling interval in seconds when running in 'watch' mode (Default: 60)
WATCH_INTERVAL=60

# Port for lightweight HTTP webhook receiver (Default: 9000)
WEBHOOK_PORT=9000

# Secret authorization token for incoming webhook calls (Optional but recommended)
WEBHOOK_SECRET=your-secret-token-here

# Optional chat notifications for deployments and rollbacks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional path to write deployment logs
# LOG_FILE=/var/log/docker-auto-updater.log
